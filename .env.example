# Domain pointing to your VPS (A record). Caddy fetches the HTTPS certificate automatically. Leave empty locally.
DOMAIN=addon.example.com

# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REDIS_PASSWORD=

# The master key is NOT stored here but in the file secrets/master_key (see README).

# Optional: Trakt app (https://trakt.tv/oauth/applications/new, redirect URI: urn:ietf:wg:oauth:2.0:oob)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Optional: Simkl app (https://simkl.com/settings/developer/)
SIMKL_CLIENT_ID=

# Optional: links to your imprint and privacy policy (needed for public instances in some countries, e.g. Germany)
IMPRINT_URL=
PRIVACY_URL=

# Optional: link for the support button (Ko-fi, PayPal.me, Buy Me a Coffee …), must start with https://
SUPPORT_URL=
